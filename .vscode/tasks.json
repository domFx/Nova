{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "cargo build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"],
            "windows": {
                "command": "cargo",
                "args": ["build"]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-c",
                    "cargo build"
                ],
            }
        }
	]
}